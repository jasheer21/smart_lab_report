# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ---- Smart Report API server (server/) ----
# Port of the API server. The Vite dev server proxies /api to it.
API_PORT=4000

# Gemini Vision OCR fallback for scanned PDFs and image scans. Falls back to GEMINI_API_KEY.
# Leave both unset if your data-processing agreement doesn't allow sending reports to Google;
# text PDFs and .txt files still work without it.
SMART_REPORT_GEMINI_API_KEY=
SMART_REPORT_GEMINI_MODEL=gemini-2.5-flash
SMART_REPORT_GEMINI_TIMEOUT_MS=90000

# Number of earlier orders of the same patient used for trend history.
SMART_REPORT_HISTORY_ORDERS=5

LAB_REPORT_MAX_FILE_MB=15
LAB_REPORT_MAX_BATCH_FILES=10

# Parsed results are kept in memory only (no database, no file storage) and expire after this.
REPORT_STORE_TTL_MINUTES=120
REPORT_STORE_MAX_ENTRIES=500
OCR_CACHE_MAX_ENTRIES=200

# Per-IP limit for upload / OCR / insights endpoints.
RATE_LIMIT_PER_MINUTE=30

# Comma-separated origins allowed to call the API cross-origin. Not needed with the Vite proxy.
CORS_ORIGIN=

# Frontend: API base URL when the API is on another origin. Leave empty to use the same origin / Vite proxy.
VITE_API_URL=
